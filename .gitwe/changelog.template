# .gitwe/changelog.template
# قالبِ خطِ هر کامیت در چنج‌لاگ. برای هر کامیت یک خط تولید می‌شود.
#
# پلیس‌هولدرهای در دسترس:
#   {{subject}}      متن کامیت، بدون پیشوند "type(scope):"
#   {{scope}}        بخش "(scope)" از یک conventional commit؛ اگر نبود، خالی است
#   {{scopePrefix}}  اگر کامیت اسکوپ داشته باشد "**scope:** " (با فاصله)،
#                    وگرنه یک رشته‌ی خالی — یعنی بدون هیچ شرط/تمپلیتی، وقتی
#                    اسکوپ نیست کل بخش بولد خودکار حذف می‌شود
#   {{shortHash}}    هش کوتاه کامیت (۷ کاراکتر)
#   {{hash}}         هش کامل کامیت
#   {{author}}       نام نویسنده‌ی کامیت

- {{scopePrefix}}{{subject}} ({{shortHash}})
